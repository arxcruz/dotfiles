set -gx PATH $PATH $HOME/.local/bin $HOME/bin
set -gx PATH $PATH ~/.npm-global/bin

# Oh-my-posh
if command -q oh-my-posh
    oh-my-posh init fish --config $HOME/.oh-my-posh.omp.toml | source
end

# Zoxide
if command -q zoxide
    zoxide init fish | source
end

# fzf
if command -q fzf
    if test -f /usr/share/doc/fzf/examples/key-bindings.fish
        source /usr/share/doc/fzf/examples/key-bindings.fish
    else if test -f /usr/share/fish/vendor_conf.d/fzf.fish
        # Already loaded by fish
    else if test -f /usr/share/fish/functions/fzf_key_bindings.fish
        source /usr/share/fish/functions/fzf_key_bindings.fish
    end
    
    # Check if fzf_key_bindings is defined and then call it
    if functions -q fzf_key_bindings
        fzf_key_bindings
    end
end

# Bat
set -gx BAT_THEME "{{ fish_bat_theme }}"

# Aliases
{% for alias in fish_aliases %}
alias {{ alias.name }}="{{ alias.value }}"
{% endfor %}

# Claude
set -gx CLAUDE_CODE_USE_VERTEX {{ fish_claude_use_vertex }}
set -gx CLOUD_ML_REGION "{{ fish_cloud_ml_region }}"
set -gx ANTHROPIC_VERTEX_PROJECT_ID "{{ fish_anthropic_vertex_project_id }}"
