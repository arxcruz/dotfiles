[Unit]
Description=ai-memory MCP server
After=network-online.target

[Container]
Image=docker.io/akitaonrails/ai-memory:latest
ContainerName=ai-memory
Network=host
SecurityLabelDisable=true
Volume=%h:%h
Volume=ai-memory-data:/data
Environment=HOME=%h
Environment=AI_MEMORY_DATA_DIR=/data
User=0:0
Exec=serve --transport http --bind 127.0.0.1:49374 --data-dir /data --enable-web

[Service]
Restart=always

[Install]
WantedBy=default.target
