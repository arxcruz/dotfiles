set -sg escape-time 5

set-option -s set-clipboard off
set-option -g focus-events on
{% if ansible_distribution == "Darwin" %}
set -s copy-command 'pbcopy'
{% elif ansible_os_family == "Archlinux" or ansible_os_family == "RedHat" or ansible_os_family == "Debian" %}
set -s copy-command 'xsel -i'
{% endif %}
bind -Tcopy-mode-vi C-j               send -X copy-pipe-and-cancel 'xsel -i'
bind -Tcopy-mode-vi Enter             send -X copy-pipe-and-cancel 'xsel -i'
bind -Tcopy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel 'xsel -i'

# Terminal & color support
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"

# ==========================================
# Powerline-style Status Bar (Native tmux)
# No Python / powerline-daemon dependency
# ==========================================
set -g status on
set -g status-interval 2
set -g status-justify left
set -g status-style "bg=colour236,fg=colour247"

# Left side: Session name
set -g status-left-length 50
set -g status-left "#[fg=colour235,bg=colour252,bold] #S #[fg=colour252,bg=colour236,nobold,nounderscore,noitalics]"

# Right side: Date, Time & Hostname
set -g status-right-length 150
set -g status-right "#[fg=colour240,bg=colour236,nobold,nounderscore,noitalics]#[fg=colour250,bg=colour240] %Y-%m-%d  %H:%M #[fg=colour252,bg=colour240,nobold,nounderscore,noitalics]#[fg=colour235,bg=colour252,bold] #h "

# Window status tabs
set -g window-status-separator ""
set -g window-status-format "#[fg=colour244,bg=colour236]  #I  #W  "
set -g window-status-current-format "#[fg=colour236,bg=colour31,nobold,nounderscore,noitalics]#[fg=colour231,bg=colour31,bold] #I  #W #[fg=colour31,bg=colour236,nobold,nounderscore,noitalics]"

# Pane borders
set -g pane-border-style "fg=colour238"
set -g pane-active-border-style "fg=colour31"

# Set mouse on or off
# <prefix> M - Turn it off
# <prefix> m - Turn it on
# Default is on

set -g mouse on;
bind m set -g mouse on \; display "Mouse ON"
bind M set -g mouse off \; display "Mouse OFF"

# Set windows to reorder automatically
set-option -g renumber-windows on

# In case tmate doesn't work
# set -g tmate-server-host "am2.tmate.io"
# Smart pane switching with awareness of Vim splits.
# See: https://github.com/christoomey/vim-tmux-navigator
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'
tmux_version='$(tmux -V | sed -En "s/^tmux ([0-9]+(.[0-9]+)?).*/\1/p")'
if-shell -b '[ "$(echo "$tmux_version < 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\'  'select-pane -l'"
if-shell -b '[ "$(echo "$tmux_version >= 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\\\'  'select-pane -l'"

bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l
